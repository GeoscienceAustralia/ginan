{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GinanTauri",
  "version": "1.0.0",
  "identifier": "au.gov.ga.ginan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ginan UI",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Geoscience Australia",
    "homepage": "https://github.com/GeoscienceAustralia/ginan",
    "copyright": "Copyright Geoscience Australia",
    "license": "Apache-2.0",
    "category": "Utility",
    "shortDescription": "Desktop GUI for the Ginan GNSS processing engine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/default_config.yaml": "resources/default_config.yaml"
    }
  }
}
