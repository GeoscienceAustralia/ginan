{
  "name": "ginan-tauri",
  "description": "Desktop GUI for the Ginan GNSS processing engine (PEA)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeoscienceAustralia/ginan.git",
    "directory": "scripts/GinanTauri"
  },
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "profile": "tauri build --no-bundle --config src-tauri/tauri.profiling.conf.json",
    "profile:dev": "tauri dev --config src-tauri/tauri.profiling.conf.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-store": "2.4.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@fltsci/tauri-plugin-tracing": "0.3.3",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
